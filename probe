#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

mode="${1:-api}"

case "$mode" in
  api)
    exec uv run uvicorn probe.api_server:app --port 8003 --reload
    ;;
  mcp)
    exec uv run python -m probe.mcp_server
    ;;
  *)
    echo "Usage: $0 [api|mcp]"
    echo "  (default: api)"
    exit 1
    ;;
esac
